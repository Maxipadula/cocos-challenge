    {
      "name": "Cancel a new limit order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": "{{baseUrl}}/orders/{{orderId}}/cancel",
        "description": "Cancels a LIMIT order that is still NEW and releases the cash or shares it reserved. Replaying the same Idempotency-Key returns the stored cancellation. A different key for an order that is no longer NEW returns 409 and does not release the reservation again."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deposit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/cash-movements",
        "description": "CASH_IN is stored as FILLED and increases settled cash. CASH_OUT is stored as FILLED when the amount fits in available cash, or as REJECTED with INSUFFICIENT_CASH when it does not. Reserved cash cannot be withdrawn. A rejected withdrawal is still persisted and this endpoint returns 201. The ARS instrument is chosen by the server.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"side\": \"CASH_IN\",\n  \"amount\": \"1500.50\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ]
    },
